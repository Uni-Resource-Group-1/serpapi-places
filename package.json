{
  "name": "places-discovery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted OSM + SerpApi places research workspace",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,worker,web -c blue,magenta,green \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:worker": "tsx watch src/server/worker.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json && node scripts/copy-geo-data.mjs",
    "geo:build": "node scripts/build-geo-data.mjs",
    "start": "node dist/server/index.js",
    "worker": "node dist/server/worker.js",
    "migrate": "node dist/server/migrate.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run tests/db",
    "test:e2e": "playwright test",
    "audit:visual": "node --env-file=.env scripts/audit-visual.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fastify/compress": "9.3.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.8",
    "archiver": "8.0.0",
    "dotenv": "17.2.3",
    "fastify": "5.12.7",
    "fflate": "^0.8.3",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/archiver": "8.0.0",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "26.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
