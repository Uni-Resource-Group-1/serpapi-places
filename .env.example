# ---- Required -------------------------------------------------------------

# Long random shared access key. Generate with:
#   openssl rand -base64 36
APP_ACCESS_KEY=

# Encrypts the SerpApi key when it is saved from the Settings UI.
# Generate with: openssl rand -hex 32
# Keep this stable: rotating it makes a stored key unreadable until it is
# re-entered. When unset, APP_ACCESS_KEY is used as a fallback, which means
# rotating APP_ACCESS_KEY also invalidates the stored SerpApi key.
SETTINGS_ENCRYPTION_KEY=

# Database password used by the bundled PostgreSQL service.
# Use only URL-safe characters, or percent-encode them in DATABASE_URL.
POSTGRES_PASSWORD=

# ---- SerpApi --------------------------------------------------------------

# Server-side only. Never commit a real key and never expose it to the browser.
# Optional: the key can instead be saved from Settings, which stores it
# encrypted. This environment value remains the fallback when no key is saved.
SERPAPI_API_KEY=

# Conservative defaults (bounded by the hard caps below).
SERPAPI_MONTHLY_LIMIT=250
SERPAPI_DAILY_LIMIT=50
SERPAPI_MAX_PAGES=6
SERPAPI_MAX_RESULTS=120
SERPAPI_PRICE_PER_SEARCH_USD=0.015

# Data policy. SerpApi records, including reviews, can be stored and exported
# for this workspace's own use. Do not republish or resell them without the
# necessary rights. Set storage/retention days to 0 to disable auto-expiry.
SERPAPI_REVIEWS_ENABLED=true
SERPAPI_EXPORT_ENABLED=true
SERPAPI_STORAGE_DAYS=0
SERPAPI_REVIEW_RETENTION_DAYS=0
SERPAPI_CACHE_TTL_SECONDS=0

# ---- Opt-in discovery limits ----------------------------------------------
MAX_TILED_AREA_KM2=10000
MAX_TILES_PER_RUN=25
MAX_PAGES_PER_TILE=3
MAX_IMPORT_PLACES=25

# ---- App -----------------------------------------------------------------

APP_ORIGIN=https://serpapiplaces.dhakafareast.tech
SESSION_DAYS=30
MAX_ACTIVE_SESSIONS=5
LOG_LEVEL=info

# ---- Hard caps (server-enforced; the Settings UI cannot exceed these) ------

SERPAPI_MONTHLY_HARD_LIMIT=1000
SERPAPI_DAILY_HARD_LIMIT=100
SERPAPI_MAX_PAGES_HARD=10
MAX_RESULTS_PER_SOURCE=500
MAX_RADIUS_METERS=20000
MAX_AREA_KM2=400
MAX_SAVED_SEARCHES=100
MAX_COLLECTIONS=50
MAX_EXPORT_ROWS=50000
EXPORT_RETENTION_HOURS=24

# ---- OpenStreetMap / Overpass ---------------------------------------------

OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_USER_AGENT=PlacesDiscovery/1.0 (self-hosted place research; contact: admin@dhakafareast.tech)
OSM_CONTACT=admin@dhakafareast.tech
OSM_MAX_RESULTS=1200
OVERPASS_TIMEOUT_MS=30000

# ---- Basemap tiles --------------------------------------------------------

TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
TILE_MAX_ZOOM=19

# ---- Docker / Traefik (compose only) --------------------------------------

# Public hostname routed by Traefik. Must match the DNS record and APP_ORIGIN.
APP_HOST=serpapiplaces.dhakafareast.tech

# Name of the existing external Traefik network.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_CERT_RESOLVER=letsencrypt
